# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
# Never commit .env.local — it is gitignored.
# ─────────────────────────────────────────────────────────────

# ===== Resend (contact form) — SERVER ONLY, keep secret =====
# 1. Create an account at https://resend.com
# 2. Add & verify your domain (limsathya.com) under Domains
# 3. Create an API key under API Keys and paste it below
RESEND_API_KEY=re_7xsbr4ka_2zWpEdsaanR9EsyigzTaMaKK

# Where contact-form messages are delivered
CONTACT_TO_EMAIL=limsathya1234@gmail.com

# The "from" address. For TESTING you may use the shared sender below,
# which Resend only delivers to your own account email:
#   CONTACT_FROM_EMAIL="Limsathya San <onboarding@resend.dev>"
# For PRODUCTION, use an address on your VERIFIED domain:
CONTACT_FROM_EMAIL=contact@limsathya.com

# ===== Public site config (exposed to the browser) =====
NEXT_PUBLIC_SITE_NAME="Limsathya San"

# Assets in /public (or full https URLs)
NEXT_PUBLIC_LOGO_URL="/profile.svg"
NEXT_PUBLIC_PROFILE_IMAGE_URL="/profile.svg"

# Public contact details
NEXT_PUBLIC_CONTACT_EMAIL="info@limsathya.com"
NEXT_PUBLIC_CONTACT_PHONE_KH="+855 89972121"
NEXT_PUBLIC_CONTACT_PHONE_CN="+86 15618072128"

# ===== Social media — leave blank to hide a link =====
NEXT_PUBLIC_SOCIAL_GITHUB="https://github.com/limsathya"
NEXT_PUBLIC_SOCIAL_INSTAGRAM="https://www.instagram.com/s.limsathya/"
NEXT_PUBLIC_SOCIAL_LINKEDIN=""
